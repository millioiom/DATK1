@model QuanLyPhongTro.Models.Room

@{
    ViewData["Title"] = "Thêm phòng trọ";
}

<div class="page-heading">

    <div>
        <p class="page-label">QUẢN LÝ DANH SÁCH PHÒNG</p>

        <h1>Thêm phòng trọ</h1>

        <p class="page-description">
            Nhập thông tin phòng trọ mới vào hệ thống.
        </p>
    </div>

    <a asp-action="Index" class="btn-secondary">
        Quay lại
    </a>

</div>


<section class="content-card form-card">

    <div class="card-heading">
        <div>
            <h3>Thông tin phòng trọ</h3>
            <p>Vui lòng điền đầy đủ thông tin bên dưới.</p>
        </div>
    </div>


    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="validation-message">
        </div>

        <div class="form-grid">

            <!-- MÃ PHÒNG -->
            <div class="form-group">
                <label asp-for="RoomCode">Mã phòng</label>

                <input asp-for="RoomCode"
                       class="form-control"
                       placeholder="Ví dụ: P106" />

                <span asp-validation-for="RoomCode"
                      class="validation-message">
                </span>
            </div>


            <!-- DIỆN TÍCH -->
            <div class="form-group">
                <label asp-for="Area">Diện tích (m²)</label>

                <input asp-for="Area"
                       type="number"
                       step="0.1"
                       min="1"
                       class="form-control"
                       placeholder="Ví dụ: 20" />

                <span asp-validation-for="Area"
                      class="validation-message">
                </span>
            </div>


            <!-- GIÁ THUÊ -->
            <div class="form-group">
                <label asp-for="Price">Giá thuê (VNĐ)</label>

                <input asp-for="Price"
                       type="number"
                       min="0"
                       class="form-control"
                       placeholder="Ví dụ: 2500000" />

                <span asp-validation-for="Price"
                      class="validation-message">
                </span>
            </div>


            <!-- TRẠNG THÁI -->
            <div class="form-group">
                <label asp-for="Status">Trạng thái</label>

                <select asp-for="Status" class="form-control">
                    <option value="Còn trống">Còn trống</option>
                    <option value="Đang thuê">Đang thuê</option>
                </select>

                <span asp-validation-for="Status"
                      class="validation-message">
                </span>
            </div>


            <!-- NGƯỜI THUÊ -->
            <div class="form-group full-width">
                <label asp-for="TenantName">
                    Họ tên người thuê
                </label>

                <input asp-for="TenantName"
                       class="form-control"
                       placeholder="Nhập tên người thuê (nếu có)" />

                <span asp-validation-for="TenantName"
                      class="validation-message">
                </span>
            </div>

        </div>


        <div class="form-actions">

            <button type="submit" class="btn-primary">
                Lưu phòng
            </button>

            <a asp-action="Index" class="btn-secondary">
                Hủy
            </a>

        </div>

    </form>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}