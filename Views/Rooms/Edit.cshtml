@model QuanLyPhongTro.Models.Room

@{
    ViewData["Title"] = "Sửa thông tin phòng";
}

<div class="page-heading">
    <div>
        <p class="page-label">QUẢN LÝ DANH SÁCH PHÒNG</p>
        <h1>Sửa thông tin phòng</h1>
        <p class="page-description">Cập nhật thông tin phòng @Model.RoomCode.</p>
    </div>

    <a asp-action="Index" class="btn-secondary">Quay lại</a>
</div>

<section class="content-card form-card">
    <div class="card-heading">
        <div>
            <h3>Thông tin phòng trọ</h3>
            <p>Điều chỉnh các thông tin cần cập nhật.</p>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-message"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="RoomCode">Mã phòng</label>
                <input asp-for="RoomCode" class="form-control" />
                <span asp-validation-for="RoomCode" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Area">Diện tích (m²)</label>
                <input asp-for="Area" type="number" step="0.1" min="1" class="form-control" />
                <span asp-validation-for="Area" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price">Giá thuê (VNĐ)</label>
                <input asp-for="Price" type="number" min="0" class="form-control" />
                <span asp-validation-for="Price" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status">Trạng thái</label>
                <select asp-for="Status" class="form-control">
                    <option value="Còn trống">Còn trống</option>
                    <option value="Đang thuê">Đang thuê</option>
                </select>
                <span asp-validation-for="Status" class="validation-message"></span>
            </div>

            <div class="form-group full-width">
                <label asp-for="TenantName">Họ tên người thuê</label>
                <input asp-for="TenantName"
                       class="form-control"
                       placeholder="Nhập tên người thuê (nếu có)" />
                <span asp-validation-for="TenantName" class="validation-message"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" class="btn-secondary">Hủy</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
